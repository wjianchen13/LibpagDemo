<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="加载assets目录下的文件，替换文字" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="horizontal">

        <org.libpag.PAGView
            android:id="@+id/pag_view"
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"/>

        <org.libpag.PAGView
            android:id="@+id/pag_view2"
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"/>

        <org.libpag.PAGView
            android:id="@+id/pag_view3"
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>



    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textAllCaps="false"
        android:text="加载网络PAG"
        android:onClick="onTest1" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textAllCaps="false"
        android:text="加载网络PAG"
        android:onClick="onTest2" />


    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textAllCaps="false"
        android:text="加载网络PAG"
        android:onClick="onTest3" />


    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textAllCaps="false"
        android:text="加载网络PAG"
        android:onClick="onTest4" />


</LinearLayout>
